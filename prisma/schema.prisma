// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  // ID do usuário, gerado como UUID no banco, mapeado para String no Prisma
  id            String    @id @default(uuid())
  name          String  
  username      String    @unique
  email         String?   @unique
  phone_number  String?   @unique
  cpf           String    @unique
  password_hash String?   @db.VarChar(255)
  created_at    DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updated_at    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)


  // Relações
  bankAccounts  BankAccount[]
  pixKeys       PixKey[]
  addresses     Address[]
  transactions  Transaction[]

  @@map("users") // Mapeia o nome do modelo para o nome da tabela no DB
}

model BankAccount {
  id            String      @id @default(uuid()) @map("id") @db.VarChar(36)
  user_id       String      @map("user_id") @db.VarChar(36) // Chave estrangeira para User
  bank_name     String      @db.VarChar(100)
  ispb          String      @db.VarChar(8)
  account_number String     @db.VarChar(25)
  branch_code   String      @db.VarChar(25)
  account_type  AccountType 
  created_at    DateTime    @default(now()) @map("created_at") @db.Timestamp(0)
  updated_at    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relações
  user          User        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  pixKeys       PixKey[] // Relação 1:N com PixKey

  @@map("bank_accounts")
}

model PixKey {
  id           String       @id @default(uuid()) @map("id") @db.VarChar(36) // ID da chave Pix
  user_id      String       @map("user_id") @db.VarChar(36)
  account_id   String       @map("account_id") @db.VarChar(36)
  key_value    String       @unique @db.VarChar(100) // Valor da chave (celular, cpf, email, evp)
  key_type     PixKeyType   
  created_at   DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updated_at   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relações
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  bankAccount  BankAccount  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("pix_keys")
}

model Address {
  id           String      @id @default(uuid()) @map("id") @db.VarChar(36)
  user_id      String      @map("user_id") @db.VarChar(36)
  cep          String      @db.VarChar(9)
  logradouro   String      @db.VarChar(255)
  numero       String?     @db.VarChar(20)
  complemento  String?     @db.VarChar(255)
  bairro       String      @db.VarChar(100)
  cidade       String      @db.VarChar(100)
  estado       String      @db.VarChar(2)
  created_at   DateTime    @default(now()) @map("created_at") @db.Timestamp(0)
  updated_at   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relações
  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("addresses")
}

model Transaction {
  id                     String          @id @default(uuid()) @map("id") @db.VarChar(36)
  user_id                String          @map("user_id") @db.VarChar(36)
  gateway_transaction_id String?         @unique @map("gateway_transaction_id") @db.VarChar(255)
  gateway_external_id    String?         @map("gateway_external_id") @db.VarChar(255)
  operation_type         OperationType   
  amount                 Decimal         @db.Decimal(18, 2)
  status                 String
  gateway_type           String          @db.VarChar(50)
  description            String?         @db.VarChar(255)
  e2e_id                 String?         @map("e2e_id") @db.VarChar(50)
  refund_e2e_id          String?         @map("refund_e2e_id") @db.VarChar(50)
  error_message          String?         @map("error_message") @db.VarChar(500)
  created_at             DateTime        @default(now()) @map("created_at") @db.Timestamp(0)
  updated_at             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relações
  user                   User            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("transactions")
}



enum OperationType {
  CREDIT
  DEBIT
}

enum PixKeyType {
  EVP
  CELULAR
  CPF
  EMAIL
}


enum AccountType {
  CACC // Conta Corrente
  SLRY // Conta Salário
  SVGS // Conta Poupança
  TRAN // Conta de Pagamento (Transação)
}